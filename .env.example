# Job Radar local environment example
# Copy to .env.jobradar or export these variables before running.

JOBRADAR_BIND_HOST=127.0.0.1
JOBRADAR_BIND_PORT=8765
JOBRADAR_DB_PATH=/absolute/path/to/job-hunter/state/jobradar.sqlite3
JOBRADAR_IMPORT_DIR=/absolute/path/to/job-hunter/processed
JOBRADAR_SESSION_DIR=/absolute/path/to/job-hunter/state/sessions

# Use false in production; true is convenient for local agent/demo testing only.
JOBRADAR_DISABLE_LOGIN=false
JOBRADAR_SECRET_KEY=change-me-long-random-secret
JOBRADAR_PASSWORD_HASH=
JOBRADAR_SERVICE_TOKEN=change-me-service-token

# Optional write hardening behind Cloudflare Access.
JOBRADAR_REQUIRE_CLOUDFLARE_ACCESS=false

# career-ops bridge
JOBRADAR_CAREEROPS_ROOT=/absolute/path/to/career-ops
JOBRADAR_NODE_BIN=/usr/bin/node

# Operations
JOBRADAR_TIMEZONE=America/Chicago
JOBRADAR_BACKUP_DIR=/absolute/path/to/backups/jobradar
